+"""Price structure for the Telegram Dan Golden manager. Only closed bars form pivots."""
+from datetime import datetime, timezone
+from decimal import Decimal, ROUND_CEILING, ROUND_FLOOR
+import math
+
+
+def on_grid(price, step, up):
+    unit = Decimal(str(step))
+    return float((Decimal(str(price)) / unit).to_integral_value(
+        rounding=ROUND_CEILING if up else ROUND_FLOOR) * unit)
+
+
+def closed_bars(state, bars, seconds, start, now, side, offset=0):
+    for bar in bars:
+        stamp = int(bar['time']) - offset
+        previous = state.get('time', 0)
+        if stamp < start or stamp + seconds > now or stamp <= previous:
+            continue
+        high, low, close = (float(bar[k]) for k in ('high', 'low', 'close'))
+        if not all(math.isfinite(p) and p > 0 for p in (high, low, close)) or not low <= close <= high:
+            continue
+        if previous and stamp != previous + seconds:
+            for key in ('previous', 'last', 'pivot', 'pullback'):
+                state.pop(key, None)
+        high, low = (high, low) if side == 1 else (-low, -high)
+        if 'pivot' in state:
+            state['pullback'] = min(low, state['pullback'])
+            if side * close > state['pivot']:
+                found = state.pop('pullback')
+                state['best'] = max(found, state.get('best', found))
+                del state['pivot']
+        elif state.get('previous') is not None and state['last'] > max(state['previous'], high):
+            state['pivot'], state['pullback'] = state['last'], low
+        state['previous'], state['last'], state['time'] = state.get('last'), high, stamp
+
+
+def market_structure(executor, settings, symbol, side, tick, now, state, target2):
+    """Live Bid/Ask plus exact historical ticks; establish the bar clock from the current bar."""
+    from .history_clock import bridge, tick_stamp
+    api = executor.mt5
+    quote_time = float(getattr(tick, 'time_msc', 0) or 0) / 1000 or float(tick.time)
+    until = min(now, quote_time)
+    def reached(bid, ask):
+        return math.isfinite(bid) and math.isfinite(ask) and 0 < bid <= ask and (
+            bid >= target2 if side == 1 else ask <= target2)
+    if target2 and until >= state['tp1_at'] and reached(float(tick.bid), float(tick.ask)):
+        state.setdefault('tp2_at', until)
+    if target2 and now >= state.get('tick_retry', 0) and hasattr(api, 'copy_ticks_range'):
+        start = max(state['tp1_at'], state.get('ticks_until', state['tp1_at']))
+        end = min(until, state.get('tp2_at', until), start + 900)
+        if end > start:
+            metadata = api.symbol_info(symbol)
+            proof = bridge(executor, symbol, settings, float(metadata.point))
+            if proof.get('status') == 'VERIFIED':
+                offset = proof['tick_offset_seconds']
+                t0 = datetime.fromtimestamp(math.floor(start + offset), timezone.utc)
+                t1 = datetime.fromtimestamp(math.floor(end + offset) + 1, timezone.utc)
+                ticks = api.copy_ticks_range(symbol, t0, t1, getattr(api, 'COPY_TICKS_ALL', -1))
+                if ticks is not None:
+                    for item in ticks:
+                        ts = tick_stamp(item) - offset
+                        if start <= ts <= end and reached(float(item['bid']), float(item['ask'])):
+                            if ts < state.get('tp2_at', float('inf')):
+                                state['tp2_at'] = ts
+                                # Rebuild from the earlier verified touch while preserving protection already earned.
+                                old = state.get('M15', {})
+                                state['M15'] = {'best': old['best']} if 'best' in old else {}
+                            break
+                    state['ticks_until'] = end
+            state['tick_retry'] = now + 5
+    if not hasattr(api, 'copy_rates_from_pos'):
+        return
+    clock = getattr(executor, '_quote_clock', None)
+    key = (settings['login'], settings['server'], settings['terminal_path'], symbol)
+    live_offset = (getattr(clock, 'last', {}).get(key) or {}).get('offset_seconds', 0)
+    for minutes, stage in ((5, 'tp1_at'), (15, 'tp2_at')):
+        if stage not in state:
+            continue
+        label, period = 'M' + str(minutes), minutes * 60
+        data = state.setdefault(label, {})
+        anchor = max(state['tp1_at'], state[stage])
+        bucket = int(until // period) * period
+        if bucket - period < anchor or data.get('time', 0) >= bucket - period or now < data.get('retry', 0):
+            continue
+        since = max(anchor, data.get('time', 0))
+        count = max(3, min(20000, math.ceil((until - since) / period) + 2))
+        bars = api.copy_rates_from_pos(symbol, getattr(api, 'TIMEFRAME_' + label, minutes), 0, count)
+        if bars is None or not len(bars):
+            data['retry'] = now + 20
+            continue
+        # Offset of the tick archive and offset of the candle archive can differ.
+        offsets = {int(o) for o in (0, live_offset) if int(bars[-1]['time']) - o == bucket}
+        if len(offsets) != 1:
+            data['retry'] = now + 20
+            continue
+        closed_bars(data, bars, period, anchor, until, side, offsets.pop())
+        data['retry'] = min(bucket + period, now + 20) if data.get('time', 0) < bucket-period else bucket + period
