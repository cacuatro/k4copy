index 0000000..2dbae8d
--- /dev/null
+++ b/app/tests/test_dan_structural_management.py
@@ -0,0 +1,260 @@
+import json
+import time
+import unittest
+from datetime import datetime, timezone
+from types import SimpleNamespace as N
+from unittest.mock import patch
+
+import test_execution as fixtures
+from k4signals import lifecycle
+from k4signals.dan_protection import MODES, _shadow
+from k4signals.dan_structure import closed_bars
+from k4signals.execution import MT5Executor
+
+
+def series(start, period, sell=False):
+    prices = [(4006,4004,4005),(4009,4005,4008),(4007,4005.5,4006),
+              (4010,4006,4008),(4011,4006.5,4010)]
+    if sell:
+        prices = [(8000-lo,8000-hi,8000-close) for hi,lo,close in prices]
+    return [dict(time=start+i*period, high=hi, low=lo, close=close) for i,(hi,lo,close) in enumerate(prices)]
+
+
+class StructureTest(unittest.TestCase):
+    def test_wick_open_bar_long_and_short(self):
+        for side in (1,-1):
+            bars = series(900,300,side==-1)
+            state = {}
+            closed_bars(state,bars,300,900,2399,side)
+            self.assertNotIn('best',state)
+            closed_bars(state,bars,300,900,2400,side)
+            self.assertEqual(state['best'],4005.5 if side==1 else -3994.5)
+
+    def test_gap_and_preactivation(self):
+        bars = series(900,300)
+        for data, start in ((bars[0:3]+bars[4:],900),(bars,901)):
+            result={}
+            closed_bars(result,data,300,start,2600,1)
