@@ -0,0 +1,392 @@
+"""Protection of broker-confirmed, journal-linked Dan Golden positions."""
+from collections import defaultdict
+from datetime import datetime, timezone
+import json
+import math
+import time
+import uuid
+
+from .audit import record
+from .dan_structure import market_structure, on_grid
+from .execution import ReviewRequired, _CONNECTION_LOCK
+from .tp_management import target_number
+
+
+PROFILE = 'dan_golden'
+MODES = ('BE + simular estrutura', 'Somente BE', 'BE + aplicar estrutura', 'Desligada')
+ACTION_INDEX = 9159
+
+
+def enabled_mode(settings):
+    mode = settings.get('dan_tp_management', MODES[0])
+    return mode if mode in MODES else 'Desligada'
+
+
+def _tables(store):
+    with store._lock, store.connection:
+        store.connection.executescript('''
+            CREATE TABLE IF NOT EXISTS dan_tp_state (
+                identity TEXT PRIMARY KEY, profile TEXT, channel_id TEXT, message_id INTEGER,
+                payload TEXT NOT NULL DEFAULT '{}', lease TEXT, lease_until REAL NOT NULL DEFAULT 0);
+            CREATE TABLE IF NOT EXISTS dan_tp_guards (
+                account_login INTEGER, account_server TEXT, magic INTEGER, symbol TEXT, position_id INTEGER,
+                PRIMARY KEY(account_login,account_server,magic,symbol,position_id));
+        ''')
+
+
+def guarded(store, settings, symbol, pid):
+    if enabled_mode(settings) == 'Desligada':
+        return False
+    with store._lock:
+        if not store.connection.execute("SELECT 1 FROM sqlite_master WHERE name='dan_tp_guards'").fetchone():
+            return False
+        return bool(store.connection.execute('SELECT 1 FROM dan_tp_guards WHERE account_login=? AND account_server=? AND magic=? AND symbol=? AND position_id=?',
+            (settings['login'], settings['server'], settings['magic'], symbol, pid)).fetchone())
+
+
+def _guard(store, settings, symbol, pid):
+    with store._lock, store.connection:
+        store.connection.execute('INSERT OR IGNORE INTO dan_tp_guards VALUES(?,?,?,?,?)',
+            (settings['login'], settings['server'], settings['magic'], symbol, pid))
+
+
+def _acquire(store, key, channel, root, now):
+    token = uuid.uuid4().hex
+    with store._lock, store.connection:
+        store.connection.execute('INSERT OR IGNORE INTO dan_tp_state(identity,profile,channel_id,message_id) VALUES(?,?,?,?)',
+                                 (key, PROFILE, str(channel), root))
+        if not store.connection.execute('UPDATE dan_tp_state SET lease=?,lease_until=? WHERE identity=? AND lease_until<=?',
+                                       (token, now+120, key, now)).rowcount:
+            return None, None
+        payload = store.connection.execute('SELECT payload FROM dan_tp_state WHERE identity=?', (key,)).fetchone()[0]
+    return token, json.loads(payload)
+
+
+def _save(store, key, token, state, release=False):
+    with store._lock, store.connection:
+        return bool(store.connection.execute('UPDATE dan_tp_state SET payload=?,lease=?,lease_until=? WHERE identity=? AND lease=?',
+            (json.dumps(state, allow_nan=False), None if release else token, 0 if release else time.time()+120, key, token)).rowcount)
+
+
+def _cost(item):
+    return sum(max(0., -float(item.get(k) or 0)) for k in ('commission', 'fee'))
+
+
+def _breakeven(ex, settings, position, info, leg, exit_rate, now, side):
+    pid = int(getattr(position, 'identifier', 0) or position.ticket)
+    if 'entry_fee_rate' not in leg and now >= leg.get('fee_retry', 0):
+        leg['fee_retry'] = now + 60
+        try:
+            history = ex.mt5.history_deals_get(position=pid)
+            entries = [d for d in (history or ()) if d.position_id == pid and d.symbol == position.symbol
+                       and d.entry == getattr(ex.mt5, 'DEAL_ENTRY_IN', 0) and d.magic in (0, settings['magic'])]
+            volume = sum(float(d.volume) for d in entries)
+            if volume > 0:
+                leg['entry_fee_rate'] = sum(_cost({k:getattr(d,k,0) for k in ('commission','fee')}) for d in entries)/volume
+        except (AttributeError, TypeError, ValueError, RuntimeError, OSError):
+            pass
+    step = float(getattr(info, 'trade_tick_size', 0) or info.point)
+    distance = float(settings.get('be_offset_points', 0)) * float(info.point)
+    fee = (leg.get('entry_fee_rate', 0) + exit_rate) * position.volume + max(0., -float(getattr(position, 'swap', 0) or 0))
+    if fee > 0:
+        tick_profit = float(getattr(info, 'trade_tick_value_profit', 0) or 0) * position.volume
+        if tick_profit <= 0:
+            try:
+                tick_profit = float(ex.mt5.order_calc_profit(position.type, position.symbol, position.volume,
+                    position.price_open, position.price_open + side * step) or 0)
+            except (AttributeError, TypeError, ValueError, RuntimeError, OSError):
+                tick_profit = 0.
+        if tick_profit > 0:
+            distance = max(distance, fee * step / tick_profit)
+    return on_grid(position.price_open + side * distance, step, side == 1)
+
+
+def _effective_tp(row, pos, exits, revisions):
+    req = row['request']
+    original = float(req.get('tp') or 0)
+    pid, ticket = row['position_id'], row['order_ticket']
+    updated = None
+    for edit in revisions:
+        change = edit['request']
+        if change.get('symbol') != req.get('symbol'):
+            continue
+        if ((pid and change.get('_managed_position_id') == pid)
+                or (pos is not None and change.get('position') == pos.ticket)
+                or (ticket and change.get('order') == ticket)):
+            updated = float(change.get('tp') or 0)
+    observed = float(pos.tp or 0) if pos is not None else next((float(d['tp']) for d in reversed(exits) if d.get('tp')), 0.)
+    if updated is not None:
+        return observed or updated
+    if req.get('_provisional_tp_distance'):
+        return observed if observed and not math.isclose(observed, original, rel_tol=0, abs_tol=1e-8) else 0.
+    return observed or original
+
+
+def _milestones(ex, state, members, positions, revisions, now):
+    target2 = []
+    first_deals = []
+    second_deals = []
+    for row, n in members:
+        if n not in (1, 2):
+            continue
+        closing = row['result'].get('closing_deals', [])
+        target = _effective_tp(row, positions.get(row['position_id']), closing, revisions)
+        if n == 2 and target > 0:
+            target2.append(target)
+        if row['status'] != 'CLOSED' or not row['position_id'] or target <= 0:
+            continue
+        for d in closing:
+            if d.get('reason') != getattr(ex.mt5, 'DEAL_REASON_TP', 5) or float(d.get('volume') or 0) <= 0:
+                continue
+            stamp = float(d.get('time_msc') or 0)/1000 or float(d.get('time') or 0)
+            # Old installs may lack a reliable deal timestamp. Start at observation in that case.
+            created = datetime.fromisoformat(row['created_at']).timestamp()
+            when = stamp if created-5 <= stamp <= now else now
+            (first_deals if n == 1 else second_deals).append((when, int(d.get('ticket') or 0), target, d))
+    if first_deals and 'tp1_at' not in state:
+        when, _, target, _ = min(first_deals, key=lambda d: (d[0], d[1]))
+        state.update(tp1_at=when, tp1=target)
+    if first_deals:
+        volume = sum(float(d['volume']) for _, _, _, d in first_deals)
+        state['exit_fee_rate'] = sum(_cost(d) for _, _, _, d in first_deals)/volume
+    if 'tp1_at' in state:
+        for when, _, _, _ in second_deals:
+            if when >= state['tp1_at']:
+                state['tp2_at'] = min(when, state.get('tp2_at', when))
+    # Multiple entries can have different targets. Only an unambiguous TP2 quote
+    # can activate the runner; its actual broker exit remains sufficient.
+    unique = set(target2)
+    return unique.pop() if len(unique) == 1 else None
+
+
+def _levels(state, number, side, be, step, padding):
+    levels = [be]
+    if number == 3 and 'tp2_at' in state:
+        floor = on_grid(state['tp1'], step, side == 1)
+        if side * (floor - be) > 0:
+            levels.append(floor)
+    label = 'M5' if number == 2 else 'M15' if number == 3 and 'tp2_at' in state else ''
+    pivot = state.get(label, {}).get('best')
+    if pivot is not None:
+        candidate = on_grid(side * (pivot - padding * step), step, side == -1)
+        if side * (candidate - levels[-1]) > 0:
+            levels.append(candidate)
+    return levels
+
+
+def _position(ex, settings, pid, symbol, side):
+    positions = ex.mt5.positions_get()
+    if positions is None:
+        return None
+    bound = [p for p in positions if int(getattr(p,'identifier',0) or p.ticket) == pid and p.symbol == symbol
+             and p.magic == settings['magic'] and p.type == (0 if side == 1 else 1)]
+    return bound[0] if len(bound) == 1 else None
+
+
+def _paper_exit(ex,channel,root,paper,pid,n,side,quote,stamp):
+    if 'sl' not in paper or stamp <= paper['set_at'] or side*(quote-paper['sl']) > 0:
+        return False
+    paper.update(exit_at=stamp, exit_quote=quote)
+    record(ex.store,'DAN_SAIDA_SIMULADA',dict(profile=PROFILE,channel_id=str(channel),message_id=root,
+           position_id=pid,target=n,simulated_sl=paper['sl'],observed_quote=quote))
+    return True
+
+
+def _paper_history(ex,settings,channel,root,state,active,side,symbol,info,until):
+    """Check the previous virtual stops before installing tighter simulated levels."""
+    from .history_clock import bridge, tick_stamp
+    watched = [(pid,n,leg['simulation']) for pid,n in active.items()
+               if (leg := state.get('positions',{}).get(str(pid),{})).get('simulation',{}).get('sl')
+               and 'exit_at' not in leg['simulation']]
+    if not watched or not hasattr(ex.mt5,'copy_ticks_range'):
+        return
+    start = min(max(p['set_at'],p.get('through',0)) for _,_,p in watched)
+    end = min(until,start+900)
+    if start >= end:
+        return
+    clock = bridge(ex,symbol,settings,float(info.point))
+    if clock.get('status') != 'VERIFIED':
+        return
+    offset = clock['tick_offset_seconds']
+    start_date = datetime.fromtimestamp(math.floor(start+offset),timezone.utc)
+    end_date = datetime.fromtimestamp(math.floor(end+offset)+1,timezone.utc)
+    ticks = ex.mt5.copy_ticks_range(symbol,start_date,end_date,getattr(ex.mt5,'COPY_TICKS_ALL',-1))
+    if ticks is None:
+        return
+    for item in ticks:
+        stamp = tick_stamp(item)-offset
+        bid,ask = float(item['bid']),float(item['ask'])
+        if not start <= stamp <= end or not 0 < bid <= ask or not math.isfinite(ask):
+            continue
+        for pid,n,paper in watched:
+            if 'exit_at' not in paper and stamp > paper.get('through',0):
+                _paper_exit(ex,channel,root,paper,pid,n,side,bid if side==1 else ask,stamp)
+    for _,_,paper in watched:
+        paper['through'] = max(end,paper.get('through',0))
+        paper['catching_up'] = end < until
+
+
+def _shadow(ex, channel, root, leg, position, pid, n, side, quote, stamp, distance, levels):
+    paper = leg.setdefault('simulation', {})
+    if 'exit_at' in paper or paper.get('catching_up'):
+        return
+    if _paper_exit(ex,channel,root,paper,pid,n,side,quote,stamp):
+        return
+    for candidate in reversed(levels):
+        if side*(quote-candidate) <= distance:
+            continue
+        if 'sl' not in paper or side*(candidate-paper['sl']) > 0:
+            paper.update(sl=candidate,set_at=stamp)
+            record(ex.store,'DAN_TRAILING_SIMULADO',dict(profile=PROFILE,channel_id=str(channel),message_id=root,
+                   position_id=pid,target=n,simulated_sl=candidate,actual_sl=position.sl,tp=position.tp))
+        break
+
+
+def _manage(ex, settings, root, channel, position, n, info, tick, state, mode, save, now):
+    pid = int(getattr(position, 'identifier', 0) or position.ticket)
+    side = 1 if position.type == 0 else -1
+    step = float(getattr(info, 'trade_tick_size', 0) or info.point)
+    leg = state.setdefault('positions', {}).setdefault(str(pid), {})
+    be = _breakeven(ex, settings, position, info, leg, state.get('exit_fee_rate', 0), now, side)
+    levels = _levels(state, n, side, be, step, settings.get('dan_structure_buffer_ticks', 1))
+    quote = float(tick.bid if side == 1 else tick.ask)
+    distance = max(info.trade_stops_level, info.trade_freeze_level) * float(info.point)
+    if mode == MODES[0]:
+        stamp = float(getattr(tick,'time_msc',0) or 0)/1000 or float(tick.time)
+        _shadow(ex,channel,root,leg,position,pid,n,side,quote,stamp,distance,levels)
+    candidates = levels if mode == MODES[2] else [be]
+    tolerance = step * .001
+    if not leg.get('guarded') and position.sl and side * (position.sl - be) >= -tolerance:
+        _guard(ex.store, settings, position.symbol, pid)
+        leg['guarded'] = True
+    if now < leg.get('retry_at', 0):
+        return
+    for sl in reversed(candidates):
+        if position.sl and side * (sl - position.sl) <= tolerance:
+            return
+        if side * (quote - sl) > distance:
+            break
+    else:
+        return
+    # Rechecking the exact position is authoritative even after a lost response.
+    attempt = leg.get('attempt', 0) + 1
+    leg['attempt'] = attempt
+    failures = min(leg.get('failures', 0) + 1, 6)
+    leg.update(failures=failures, retry_at=now + min(60, 2**failures))
+    if not save():
+        return
+    msg = dict(profile=PROFILE, channel_id=str(channel), message_id=root, revision=attempt, source='live',
+               date=datetime.now(timezone.utc).isoformat(), text='Gestão local do DAN após execução do TP1')
+    request = dict(action=getattr(ex.mt5,'TRADE_ACTION_SLTP',6), symbol=position.symbol,
+                   position=int(position.ticket), magic=settings['magic'], sl=sl, tp=float(position.tp),
+                   _source_identifier=pid, _dan_auto_stop=True)
+    outcome = ex._send(msg, ACTION_INDEX, pid, 'UPDATE_SL', request, settings, idea=root)
+    fresh = _position(ex, settings, pid, position.symbol, side)
+    confirmed = fresh is not None and fresh.sl and side*(fresh.sl-sl) >= -tolerance
+    if confirmed:
+        leg.update(failures=0, retry_at=0)
+        _guard(ex.store, settings, position.symbol, pid)
+        leg['guarded'] = True
+    status = 'SL_CONFIRMADO' if confirmed else outcome['status'] + '_AGUARDA_CONFERENCIA'
+    event = [status, sl, outcome.get('retcode')]
+    if event != leg.get('last_event'):
+        leg['last_event'] = event
+        record(ex.store, 'DAN_GESTAO_TP', dict(profile=PROFILE, channel_id=str(channel), message_id=root,
+               position_id=pid, target=n, sl=sl, status=status, retcode=outcome.get('retcode')))
+    return bool(confirmed)
+
+
+def monitor(ex, profile, channel, rows, held):
+    if profile != PROFILE or ex.mode not in ('LIVE', 'DEMO') or not any(p.get('status') == 'POSITION' for p in held):
+        return
+    settings = ex._settings(profile)
+    mode = enabled_mode(settings)
+    if mode == 'Desligada':
+        return
+    symbol = settings.get('symbol_map', {}).get('XAUUSD')
+    active_roots = {mid for position in held if position.get('status') == 'POSITION' and position.get('symbol') == symbol
+                    for mid in position.get('source_message_ids', ())}
+    groups = defaultdict(list)
+    owners = defaultdict(set)
+    for row in rows:
+        req = row['request']
+        if row['kind'] not in ('NEW_ENTRY','ADD_ENTRY') or req.get('symbol') != symbol or req.get('magic') != settings['magic']:
+            continue
+        root = row['idea_message_id'] or row['message_id']
+        if root not in active_roots:
+            continue
+        side = 1 if req['type'] in (0,2,4) else -1
+        try:
+            n = target_number(ex, row)
+        except ReviewRequired:
+            if row['position_id']:
+                owners[row['position_id']].add((root,side,None))
+            continue
+        groups[root,side].append((row,n))
+        if row['position_id']:
+            owners[row['position_id']].add((root,side,n))
+    if not groups:
+        return
+    _tables(ex.store)
+    changed = False
+    with _CONNECTION_LOCK:
+        ex._connect(profile, settings)
+        try:
+            inventory, _ = ex._inventory()
+            positions = {int(getattr(p,'identifier',0) or p.ticket):p for p in inventory
+                         if p.symbol == symbol and p.magic == settings['magic']}
+            revisions = [r for r in rows if r['kind'] == 'UPDATE_TP' and r['status'] == 'CONFIRMED']
+            for (root, side), members in groups.items():
+                members = [(r,n) for r,n in members if len(owners[r['position_id']]) <= 1]
+                active = {r['position_id']:n for r,n in members if n >= 2 and r['position_id'] in positions
+                          and positions[r['position_id']].type == (0 if side == 1 else 1)}
+                if not active:
+                    continue
+                now = time.time()
+                key = json.dumps([profile, str(channel), settings['login'], settings['server'], settings['magic'], root, symbol, side])
+                token, state = _acquire(ex.store, key, channel, root, now)
+                if not token:
+                    continue
+                try:
+                    target2 = _milestones(ex, state, members, positions, revisions, now)
+                    if 'tp1_at' not in state:
+                        continue
+                    info, tick = ex.mt5.symbol_info(symbol), ex._tick(symbol, settings)
+                    if info is None:
+                        continue
+                    def save():
+                        return _save(ex.store, key, token, state)
+                    # Give the mandatory BE priority over historical tick and candle queries.
+                    for pid, n in list(active.items()):
+                        try:
+                            if _manage(ex, settings, root, channel, positions[pid], n, info, tick, state, 'Somente BE', save, now):
+                                changed = True
+                                fresh = _position(ex, settings, pid, symbol, side)
+                                if fresh is None:
+                                    del active[pid]
+                                else:
+                                    positions[pid] = fresh
+                        except ReviewRequired as error:
+                            state.setdefault('positions',{}).setdefault(str(pid),{})['last_review'] = str(error)
+                    if mode == 'Somente BE':
+                        continue
+                    if target2 is not None and side*(target2-state['tp1']) <= 0:
+                        target2 = None
+                    try:
+                        market_structure(ex, settings, symbol, side, tick, now, state, target2)
+                        if mode == MODES[0]:
+                            _paper_history(ex,settings,channel,root,state,active,side,symbol,info,
+                                           float(getattr(tick,'time_msc',0) or 0)/1000 or float(tick.time))
+                    except (RuntimeError, OSError, AttributeError, KeyError, ValueError, TypeError) as error:
+                        state['market_data_error'] = type(error).__name__
+                    for pid, n in active.items():
+                        try:
+                            if _manage(ex, settings, root, channel, positions[pid], n, info, tick, state, mode, save, now):
+                                changed = True
+                        except ReviewRequired as error:
+                            state.setdefault('positions',{}).setdefault(str(pid),{})['last_review'] = str(error)
+                finally:
+                    _save(ex.store, key, token, state, release=True)
+        finally:
+            ex.mt5.shutdown()
+    return changed
