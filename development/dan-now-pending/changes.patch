+import copy
+import json
+import unittest
+from datetime import datetime, timezone, timedelta
+import test_instant
+from test_execution import entry, proposal
+from k4signals.grounding import check_action_numbers
+from k4signals.now_pending import monitor
+from k4signals.execution import MT5Executor
+
+class NowPendingTests(unittest.TestCase):
+ def setUp(self):
+  self.f=test_instant.InstantTests();self.f.setUp();self.addCleanup(self.f.doCleanups)
+  self.f.config['profiles']['dan_golden']['execution']['enforce_total_risk_limit']=False
+  from types import SimpleNamespace
+  original=self.f.m.order_send
+  def send(req):
+   if req['action']==7:
+    self.f.m.sent.append(dict(req));o=next(o for o in self.f.m.orders if o.ticket==req['order']);o.sl,o.tp=req['sl'],req['tp']
+    return SimpleNamespace(retcode=10009,order=o.ticket,deal=0,volume=0,price=o.price_open)
+   return original(req)
+  self.f.m.order_send=send
+ def command(self, level=3995, side='BUY'):
+  f=self.f
+  f.payload=proposal(entry(side=side,entry_prices=[level],sl_price=None,tp_prices=[]))
+  return f.ingest(1,f'{side} now {level}')
+ def test_tolerance_three_market(self):
+  r=self.command(3997.5);self.assertEqual(len(self.f.m.positions),3,r)
+ def test_fallback_three_limits_and_no_duplicate(self):
+  r=self.command();self.assertEqual(len(self.f.m.orders),3,r)
+  self.assertEqual({o.price_open for o in self.f.m.orders},{3995})
+  self.assertEqual({o.sl for o in self.f.m.orders},{3983})
+  before=len(self.f.m.sent);self.f.ingest(1,'BUY now 3995','edit',self.f.now.isoformat())
+  self.assertEqual(len(self.f.m.sent),before)
+ def test_sell_fallback(self):
+  r=self.command(4005,'SELL');self.assertEqual(len(self.f.m.orders),3,r)
+  self.assertEqual({o.type for o in self.f.m.orders},{3})
+ def test_favourable_move_does_not_create_stop(self):
+  r=self.command(4005);self.assertEqual(len(self.f.m.sent),0,r)
+ def test_separate_sl_tp_update_same_pending(self):
+  self.command();f=self.f
+  f.payload=proposal(entry(entry_prices=[3995],sl_price=3984,tp_prices=[],tp_open=True,target_message_ids=[1]))
+  r=f.ingest(2,'SL 3984');self.assertEqual({o.sl for o in f.m.orders},{3984},r)
+  f.payload=proposal(entry(entry_prices=[3995],sl_price=3984,tp_prices=[4010],target_message_ids=[1]))
+  r=f.ingest(3,'TP 4010');self.assertEqual({o.tp for o in f.m.orders},{4010},r)
+  self.assertEqual(sum(r['action']==5 for r in f.m.sent),3)
+ def test_parameter_source_does_not_cross_another_signal(self):
+  self.command();f=self.f
+  f.store.upsert(f.msg(2,'SELL NOW 4010'),source='live')
+  f.store.upsert(f.msg(3,'SL 3984'),source='live')
+  a=proposal(entry(entry_prices=[3995],sl_price=3984,tp_prices=[4010],target_message_ids=[1]))
+  result=check_action_numbers(f.msg(4,'TP 4010').to_dict(),a,f.store)
+  self.assertEqual(result['decision'],'REVIEW')
+ def test_monitor_tp_after_restart_cancels_only_pending(self):
+  self.test_separate_sl_tp_update_same_pending();f=self.f
+  f.m.tick.bid=4010;f.m.tick.ask=4010.2
+  e=MT5Executor(f.config,f.store,f.m)
+  monitor(e,f.store,'dan_golden','-1001')
+  self.assertEqual(len(f.m.orders),0)
+  before=len(f.m.sent);monitor(e,f.store,'dan_golden','-1001');self.assertEqual(len(f.m.sent),before)
