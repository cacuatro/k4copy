+"""Scoped Dan NOW fallback and journal-backed pending retirement."""
+from datetime import datetime, timezone
+import re
+
+
+def eligible(executor, message, action):
+    from .instant import now_side, policy
+    from .policies import stage_source
+    if (message.get('source') not in {'live', 'edit'} or not policy(executor.config, message['profile'])
+        or action.get('kind') != 'NEW_ENTRY' or action.get('symbol') != 'XAUUSD'
+        or action.get('order_type') != 'MARKET' or action.get('timing') != 'NOW'
+        or action.get('condition') or action.get('entry_mode') != 'SINGLE'):
+        return False
+    origin = stage_source(executor.store, message, action) if action.get('target_message_ids') else message
+    return bool(origin and now_side(origin['text']) == action.get('side'))
+
+
+def parameter_sources(store, message, original):
+    """Only literal parameter-only followups within an unbroken NOW sequence.
+
+    A new entry, unrelated reply, changed parameter or ambiguous text ends the
+    chain. Values remain separated by field; a TP cannot authorize a stop.
+    """
+    if message.get('profile') != 'dan_golden':
+        return {}
+    rows = store.recent(message['profile'], str(message['channel_id']), before_id=message['message_id'], limit=200)
+    rows = sorted((r for r in rows if r['message_id'] > original['message_id']), key=lambda r:r['message_id'])
+    values = {}
+    for row in rows:
+        if row.get('reply_to_id') not in (None, original['message_id']):
+            return {}
+        versions = store.revisions(message['profile'], str(message['channel_id']), row['message_id'])
+        if not versions or versions[0]['source'] != 'live' or any(v['text'].strip() != row['text'].strip() for v in versions):
+            return {}
+        match = re.fullmatch(r'\s*(SL|TP)\s*[:=]?\s*(\d+(?:[.,]\d+)?)\s*', row['text'], re.I)
+        if not match:
+            return {}
+        age = (datetime.fromisoformat(row['date']) - datetime.fromisoformat(original['date'])).total_seconds()
+        if not 0 <= age <= 300:
+            return {}
+        field = 'sl_price' if match[1].upper() == 'SL' else 'tp_prices'
+        value = float(match[2].replace(',', '.'))
+        if field in values and values[field]['value'] != value:
+            return {}
+        values[field] = {'value': value, 'message_id': row['message_id']}
+    return values
+
+
+def monitor(executor, store, profile, channel):
+    """Cancel only tagged fallback pending tickets; never close filled positions.
+
+    Uses verified fresh quotes and persists a retirement decision across restart.
+    Runs while the application monitors the account; it is not a broker OCO.
+    """
+    if profile != 'dan_golden' or executor.mode not in {'LIVE', 'DEMO'}:
+        return
+    from .execution import _CONNECTION_LOCK
+    if not any(r['status'] == 'PENDING' and r['request'].get('_now_pending_expires_at') for r in executor._rows(profile, str(channel))):
+        return
+    with _CONNECTION_LOCK:
+        settings = executor._settings(profile)
+        executor._connect(profile, settings)
+        _, orders = executor._reconcile(profile, str(channel), settings)
+        rows = [r for r in executor._rows(profile, str(channel)) if r['kind'] == 'NEW_ENTRY'
+                and r['status'] == 'PENDING' and r['request'].get('_now_pending_expires_at')]
+        with store._lock, store.connection:
+            store.connection.execute('CREATE TABLE IF NOT EXISTS now_pending_retirement(action_key TEXT PRIMARY KEY, reason TEXT NOT NULL)')
+        groups = {}
+        for row in rows:
+            groups.setdefault(row['idea_message_id'] or row['message_id'], []).append(row)
+        for root, members in groups.items():
+            active = [(r, o) for r in members for o in orders if r['order_ticket'] == int(o.ticket)
+                      and o.magic == settings['magic'] and o.symbol == r['request']['symbol']]
+            if not active:
+                continue
+            tick = executor._tick(active[0][1].symbol, settings)
+            buying = active[0][1].type in (2, 4)
+            closing = float(tick.bid if buying else tick.ask)
+            hit = any(float(o.tp or 0) and (closing >= o.tp if buying else closing <= o.tp) for _, o in active)
+            for row, order in active:
+                expired = datetime.now(timezone.utc) >= datetime.fromisoformat(row['request']['_now_pending_expires_at'])
+                with store._lock, store.connection:
+                    if hit or expired:
+                        store.connection.execute('INSERT OR IGNORE INTO now_pending_retirement VALUES (?,?)',
+                                                 (row['action_key'], 'TP_BEFORE_ENTRY' if hit else 'EXPIRED'))
+                    reason = store.connection.execute('SELECT reason FROM now_pending_retirement WHERE action_key=?', (row['action_key'],)).fetchone()
+                if not reason:
+                    continue
+                message = dict(profile=profile, channel_id=str(channel), message_id=row['message_id'], revision=1,
+                               source='live', date=datetime.now(timezone.utc).isoformat(), text='Local NOW pending retirement')
+                request = dict(action=8, order=int(order.ticket), magic=settings['magic'], _source_symbol=order.symbol)
+                from .audit import record
+                record(store, 'NOW_PENDING_RETIREMENT', dict(profile=profile, channel_id=str(channel), ticket=int(order.ticket), reason=reason[0], source_message_id=root))
+                executor._send(message, 900, int(order.ticket), 'CANCEL_PENDING', request, settings)
+
+
+def common_target(store, message, action, price):
+    """A literal unnumbered TP applies to the three allocated NOW legs."""
+    from .instant import now_side
+    from .policies import stage_source
+    import json
+    ids = action.get('target_message_ids') or []
+    literal = re.fullmatch(r'\s*TP\s*[:=]?\s*(\d+(?:[.,]\d+)?)\s*', message.get('text', ''), re.I)
+    if message.get('profile') != 'dan_golden' or len(ids) != 1 or not literal or float(literal[1].replace(',', '.')) != price:
+        return False
+    original = store.get(message['profile'], str(message['channel_id']), ids[0])
+    if not original or not now_side(original['text']):
+        return False
+    if not stage_source(store, message, dict(action, side=now_side(original['text']))):
+        return False
+    with store._lock:
+        if not store.connection.execute("SELECT 1 FROM sqlite_master WHERE name='execution_journal'").fetchone():
+            return False
+        rows = store.connection.execute("SELECT request FROM execution_journal WHERE profile=? AND channel_id=? AND message_id=? AND kind='NEW_ENTRY'", (message['profile'], str(message['channel_id']), ids[0])).fetchall()
+    requests = [json.loads(r[0]) for r in rows]
+    return bool(requests) and all(r.get('_instant_now') is True for r in requests)
